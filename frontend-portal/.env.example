# Same-origin: the browser calls /api on this app, which proxies to the
# backend (see rewrites in next.config.js). Baked in at BUILD time.
NEXT_PUBLIC_API_URL=/api

# Proxy target for the /api rewrite, read at runtime. Defaults to the
# local backend; in Docker point it at the internal service address.
BACKEND_URL=http://localhost:4000

# Link back to the staff admin app from the login screen.
NEXT_PUBLIC_STAFF_APP_URL=http://localhost:3000
