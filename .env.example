# ── Root env for docker-compose / Dokploy ────────────────────────────
# Copy to .env for local `docker compose up`, or paste these into the
# Dokploy application's Environment tab.

# Supabase project (backend, server-side)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
JWT_SECRET=<supabase-jwt-secret>

# Public URL of the FRONTEND — used by the backend for CORS.
# Local:   http://localhost:3000
# Dokploy: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000

# Public URL of the BACKEND API — baked into the frontend at BUILD time.
# Must be the backend's public origin + /api.
# Local:   http://localhost:4000/api
# Dokploy: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
