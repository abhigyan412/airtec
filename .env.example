# ── Root env for docker-compose / Dokploy ────────────────────────────
# Copy to .env for local `docker compose up`, or paste these into the
# Dokploy application's Environment tab.

# Supabase project (backend, server-side)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
JWT_SECRET=<supabase-jwt-secret>

# Frontend API base — relative, same-origin. The browser calls the
# frontend at /api and it proxies to the backend (rewrite in
# next.config.js). Baked into the frontend at build time; leave as /api.
NEXT_PUBLIC_API_URL=/api

# Proxy target for the frontend's /api rewrite. Defaults to the internal
# Docker service address, so you normally leave this unset. Baked in at
# BUILD time. Only the frontend needs a public domain; there is no CORS.
BACKEND_URL=http://backend:4000

# Host ports (loopback-bound, 127.0.0.1). Change to dodge a clash on the
# host; domain routing (Traefik → container port) is unaffected either way.
WEB_HOST_PORT=3000
BACKEND_HOST_PORT=4000
