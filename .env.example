# ── Root env for docker-compose / Dokploy ────────────────────────────
# Copy to .env for local `docker compose up`, or paste these into the
# Dokploy application's Environment tab.

# Supabase project (backend, server-side)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
JWT_SECRET=<supabase-jwt-secret>

# Frontend API base — relative, same-origin. The browser calls the
# frontend at /api and it proxies to the backend (rewrite in
# next.config.js). Baked into the frontend at build time; leave as /api.
NEXT_PUBLIC_API_URL=/api

# Same thing for the family portal, kept separate so the two apps can be
# pointed at different bases if they are ever split across hosts.
PORTAL_NEXT_PUBLIC_API_URL=/api

# Proxy target for the frontend's /api rewrite. Defaults to the internal
# Docker service address, so you normally leave this unset. Baked in at
# BUILD time. Only the frontend needs a public domain; there is no CORS.
BACKEND_URL=http://backend:4000

# Host ports (loopback-bound, 127.0.0.1). Defaults 3010/3011/4010 to
# avoid a clash with other apps on a shared Dokploy host. Set to any free
# ports. The public domains (Traefik → container ports 3000 and 3001) are
# unaffected by these.
WEB_HOST_PORT=3010
PORTAL_HOST_PORT=3011
BACKEND_HOST_PORT=4010

# Cross-app links the BROWSER follows, so these must be public domains,
# not internal service names. Baked in at BUILD time.
#   on the staff app  → where a parent/student who lands there is sent
#   on the portal     → the "staff sign in here" link
NEXT_PUBLIC_FAMILY_APP_URL=
NEXT_PUBLIC_STAFF_APP_URL=

# ── Web push ─────────────────────────────────────────────────────────
# Generate once:  npx web-push generate-vapid-keys
# Rotating these invalidates every existing browser subscription, so they
# are long-lived. Push is skipped (not failed) when unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourschool.com

# ── Native push for the Median-wrapped app ───────────────────────────
# The Median webview has no Web Push API, so the VAPID pair above can
# never reach a phone running the wrapped app. Those devices register a
# OneSignal subscription id and are pushed through APNs/FCM instead.
# Both values come from the OneSignal dashboard and must match the
# credentials in Median App Studio's OneSignal plugin.
#
# When these are unset the app still reports push as working for anyone
# who also has a browser subscription — the delivery is marked `sent`
# because the browser was reached — while every phone is skipped. Check
# GET /api/notifications/push/subscriptions, which reports
# `providers.onesignal`, rather than trusting a delivery status.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Where a push tap lands. Notification links are app-relative and a
# relative target is not something a native notification can act on, so
# without this every OneSignal tap opens the app's default page.
APP_BASE_URL=https://staff.yourschool.com

# ── Payments ─────────────────────────────────────────────────────────
# Required in production: activeProvider() THROWS when this is unset and
# NODE_ENV is production. It used to default silently to 'mock', which
# meant a live deploy ran the simulator — and what the simulator does is
# mark orders paid. Keep 'mock' until a real gateway is wired.
PAYMENT_PROVIDER=mock
# Signs and verifies the provider callback. The backend refuses to serve
# the gateway routes without it. Any long random string (>= 16 chars)
# while the provider is 'mock'.
PAYMENT_WEBHOOK_SECRET=
# Only with PAYMENT_PROVIDER=razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Misc ─────────────────────────────────────────────────────────────
# A container defaults to UTC, which is 5.5 hours behind the school — so
# an evening collection on 31 March files itself into the next financial
# year. Compose defaults this to Asia/Kolkata; override only for a
# school in another zone.
TZ=Asia/Kolkata

# CORS allow-list. Both apps proxy /api over the internal Docker
# network, so same-origin traffic needs none of these. They matter only
# if a browser is ever pointed straight at the backend's own domain.
ALLOWED_ORIGINS=
FRONTEND_URL=
FAMILY_FRONTEND_URL=

# HRMS attendance source. Defaults in code to the live analytics host;
# override only to point at a staging instance.
SCHOOLKNOT_BASE_URL=
