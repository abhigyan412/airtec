PORT=4000
NODE_ENV=development

# Supabase - get from your project settings
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT secret (same as Supabase JWT secret)
JWT_SECRET=your_jwt_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# The school's timezone. Everything date-shaped depends on it — which day a
# receipt belongs to, which month a collection lands in, and which financial
# year a payment taken on the evening of 31 March falls into.
TZ=Asia/Kolkata

# Payment gateway.
#
# 'mock' runs the whole flow (order -> confirm -> signed callback -> capture ->
# receipt) without moving money. 'razorpay' additionally needs RAZORPAY_KEY_ID
# and RAZORPAY_KEY_SECRET.
#
# In development both of these may be omitted: the driver defaults to mock and
# the webhook key is generated randomly per process. In production BOTH are
# required and the gateway routes return 503 until they are set — there is no
# fallback key, because the one that used to be here was a constant in the
# repository and anyone could sign a "paid" callback with it.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change_me_to_a_long_random_string
