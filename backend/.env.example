PORT=4000
NODE_ENV=development

# Supabase - get from your project settings
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT secret (same as Supabase JWT secret)
JWT_SECRET=your_jwt_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# The school's timezone. Everything date-shaped depends on it — which day a
# receipt belongs to, which month a collection lands in, and which financial
# year a payment taken on the evening of 31 March falls into.
TZ=Asia/Kolkata

# Payment gateway.
#
# 'mock' runs the whole flow (order -> confirm -> signed callback -> capture ->
# receipt) without moving money. 'razorpay' additionally needs RAZORPAY_KEY_ID
# and RAZORPAY_KEY_SECRET.
#
# In development both of these may be omitted: the driver defaults to mock and
# the webhook key is generated randomly per process. In production BOTH are
# required and the gateway routes return 503 until they are set — there is no
# fallback key, because the one that used to be here was a constant in the
# repository and anyone could sign a "paid" callback with it.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change_me_to_a_long_random_string

# ── OneSignal — native push for the Median-wrapped mobile app ───────
# The webview has no Web Push API, so app devices are pushed through
# OneSignal to APNs/FCM instead. Both values come from the OneSignal
# dashboard (Settings → Keys & IDs) and must match the credentials
# entered in Median App Studio's OneSignal plugin.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Absolute base used to turn a notification's app-relative link into the
# URL a push tap opens. Without it, taps open the app's default page.
APP_BASE_URL=https://your-app-domain

# ── Anthropic Claude — fee-hold policy copilot ───────────────────────
# Powers POST /api/admission/policy-copilot/ask: lets a School Admin or
# Principal ask a plain-English "what if" question about the fee-hold
# window and get a prose answer grounded in the existing
# simulateFeeHoldPolicy() backtest — the model's only job is to call that
# one tool and narrate its real output, never invent numbers itself.
#
# Optional. When unset, GET /policy-copilot/status reports available:false
# and the frontend hides the Ask box; POST /ask itself also degrades to a
# 503 rather than crashing — same supported-when-absent convention as
# ONESIGNAL_* above, not a startup failure.
ANTHROPIC_API_KEY=

# ── Marketing-site leads ─────────────────────────────────────────────
# Incoming-webhook URL for the team chat (Slack, Google Chat or Discord).
# Every demo request and free-trial request from the marketing site
# (POST /api/public/leads) is stored in marketing_leads and then posted
# here as one line. Optional: unset means leads are stored but nobody is
# pinged. A failed ping is logged and never fails the submission.
LEADS_WEBHOOK_URL=
